{
  "name": "kpss-habit-tracker",
  "version": "1.0.0",
  "description": "Personal habit and KPSS study tracker",
  "main": "main.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "electron": "electron .",
    "start": "npm run build:dev && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "install:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.erkam.kpss-habit-tracker",
    "productName": "KPSS Habit Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**",
      "data/**",
      "node_modules/**",
      "!node_modules/.cache"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KPSS Habit Tracker"
    }
  }
}
